<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Local inverter dashboards commonly use HTTP on a trusted LAN or Tailscale network. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
